# Copy to .env and fill in. Never commit .env.

# Setup uses three different secrets: one unlocks your Obsidian account
# (email and password, or OBSIDIAN_AUTH_TOKEN), one unlocks an end-to-end
# encrypted vault (OBSIDIAN_VAULT_PASSWORD), and one unlocks this server
# for your AI clients (MCP_AUTH_TOKEN).

# Unlocks your Obsidian account (Sync subscription required). Leave both
# empty and set OBSIDIAN_AUTH_TOKEN below if the account has MFA enabled.
OBSIDIAN_EMAIL=you@example.com
OBSIDIAN_PASSWORD=your-account-password

# Unlocks your Obsidian account instead of the two above. Get one with:
# docker run --rm -it ghcr.io/dakotahp/crystal-cove:latest \
#   sh -c 'ob login && cat ~/.config/obsidian-headless/auth_token'
# ob login is skipped when this is set.
#OBSIDIAN_AUTH_TOKEN=

# Comma-separated remote vault names, each optionally Name:e2e-password.
# Example: Work:secret1,Personal
OBSIDIAN_VAULTS=Work

# Unlocks end-to-end encrypted vaults that have no password of their own in
# OBSIDIAN_VAULTS. Not your account password. Without it, an encrypted vault
# stops the container with "Password not provided".
#OBSIDIAN_VAULT_PASSWORD=

# Unlocks this server: the static bearer token (API key) MCP clients send.
# At least 32 characters; the server refuses to start with a shorter one.
# Generate: openssl rand -hex 32. Optional when OAUTH_ISSUER is configured.
MCP_AUTH_TOKEN=

# --- Optional: delegate auth to an OpenID Connect identity provider ---
# Setting OAUTH_ISSUER enables OAuth: bearer JWTs from this issuer are
# accepted (alongside MCP_AUTH_TOKEN if that is also set). Works with any
# OIDC-compliant provider (Keycloak, Auth0, Entra ID, ...).
#OAUTH_ISSUER=https://idp.example.com/realms/myrealm
# Audience the token must carry in aud (or azp). Required with OAUTH_ISSUER.
#OAUTH_AUDIENCE=crystal-cove
# This server's public URL — advertised to MCP clients as the protected
# resource identifier. Required with OAUTH_ISSUER.
#MCP_PUBLIC_URL=https://obsidian.example.com
# Where to fetch discovery/JWKS from when the public issuer is not
# reachable from inside your network (e.g. a cluster-internal URL).
#OAUTH_INTERNAL_ISSUER=http://keycloak.infra.svc.cluster.local:8080/realms/myrealm
# Roles a token must carry. Without them any account the provider issues a
# token to can use every tool, so set a role only you hold.
#OAUTH_REQUIRED_ROLES=vault-owner
# Scopes advertised in the protected-resource metadata.
# Default: openid,profile,email
#OAUTH_SCOPES=openid,profile,email

# Optional: stable device name shown in Obsidian Sync version history.
# Defaults to CrystalCove-<8 random hex chars> per boot.
#OBSIDIAN_DEVICE_NAME=crystal-cove-prod

# Optional: expose only the read and search tools.
#MCP_READ_ONLY=true

# Optional: let delete_note remove notes outright. Off by default, so deletes
# only move notes to the vault's .trash, where they stay recoverable.
#MCP_ALLOW_PERMANENT_DELETE=true

# Optional: host port to publish. The container always listens on 8080.
#HOST_PORT=8080

# Optional: host address to publish on. Defaults to 127.0.0.1 so only a
# reverse proxy or tunnel on this host can reach the plain-HTTP port.
# 0.0.0.0 exposes it to every network the host is on.
#BIND_ADDRESS=127.0.0.1
